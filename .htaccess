Options -Indexes -MultiViews
DirectoryIndex index.html index.php
DirectoryIndexRedirect off
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Block execution of PHP files inside the uploaded-images folder
  RewriteRule ^assets/images/uploads/.*\.(php|php8|phtml|phar)$ - [F,L]
  # Force HTTPS + www (skip local development hosts)
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.bdst\.or\.tz$ [NC]
  RewriteRule ^ https://www.bdst.or.tz%{REQUEST_URI} [R=302,L]
  # Keep the real 404 page accessible
  RewriteRule ^404\.html$ - [L]
  # Remove index.html or index.php from browser URL
  RewriteCond %{THE_REQUEST} \s/+index\.(html|php)([\s?]|$) [NC]
  RewriteRule ^index\.(html|php)$ / [R=302,L]
  # Remove .html from direct browser requests
  RewriteCond %{THE_REQUEST} \s/+([A-Za-z0-9_-]+)\.html([\s?]|$) [NC]
  RewriteCond %1 !^404$ [NC]
  RewriteRule ^([A-Za-z0-9_-]+)\.html$ /$1 [R=302,L,NE]
  # Do not rewrite real files or real directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # The canonical dashboard URL is /dashboard (no trailing slash), which keeps
  # relative asset/css/js paths resolving against the webroot. /dashboard/
  # (directory-like) would break those relative paths, so canonicalize it away.
  RewriteRule ^dashboard/$ /dashboard [R=301,L]
  # Internally map clean URLs to root .html files, then .php files
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([A-Za-z0-9_-]+)/?$ $1.html [L]
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^([A-Za-z0-9_-]+)/?$ $1.php [L]
</IfModule>

# -------------------------------------------------------
# CACHE CONTROL â€” No browser caching for HTML/CSS/JS
# BUT: Allow Last-Modified & ETag so JS can detect updates
# -------------------------------------------------------
<IfModule mod_headers.c>
  # Remove static ETag (file-inode based) â€” use Last-Modified instead
  FileETag MTime Size
  <FilesMatch "\.(html|htm|css|js)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    # Keep Last-Modified header intact for change detection
    Header always unset ETag
  </FilesMatch>
  # Security headers (Phase 5 hardening)
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Hide server directory info (security)
  Header always unset X-Powered-By
  Header always unset Server
</IfModule>

# -------------------------------------------------------
# PHASE 5 HARDENING - never serve dev/backup/sensitive files
# -------------------------------------------------------
<IfModule mod_authz_core.c>
  # SQL dumps, notes, logs, env-style files and other non-website artifacts
  <FilesMatch "\.(sql|md|log|bak|ini|sh|ps1|env|csv|json)$">
    Require all denied
  </FilesMatch>
  # The live DB/email config lives ABOVE the web root; if a copy ever ends up
  # below it, it must not be downloadable.
  <FilesMatch "^mail-config.*\.php$">
    Require all denied
  </FilesMatch>
  # Renamed / leftover deploy helpers (defence in depth)
  <FilesMatch "^_(bk|up|chk|deploy|fetch|dl|diag|maint|verify|probe|uptest)[A-Za-z0-9_]*\.php$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
