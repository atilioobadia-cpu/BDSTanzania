Options -Indexes -MultiViews
DirectoryIndex index.html index.php
DirectoryIndexRedirect off
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Block execution of PHP files inside the uploaded-images folder
  RewriteRule ^assets/images/uploads/.*\.(php|php8|phtml|phar)$ - [F,L]
  # Force HTTPS + www (skip local development hosts)
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.bdst\.or\.tz$ [NC]
  RewriteRule ^ https://www.bdst.or.tz%{REQUEST_URI} [R=302,L]
  # Keep the real 404 page accessible
  RewriteRule ^404\.html$ - [L]
  # Remove index.html or index.php from browser URL
  RewriteCond %{THE_REQUEST} \s/+index\.(html|php)([\s?]|$) [NC]
  RewriteRule ^index\.(html|php)$ / [R=302,L]
  # Remove .html from direct browser requests
  RewriteCond %{THE_REQUEST} \s/+([A-Za-z0-9_-]+)\.html([\s?]|$) [NC]
  RewriteCond %1 !^404$ [NC]
  RewriteRule ^([A-Za-z0-9_-]+)\.html$ /$1 [R=302,L,NE]
  # Do not rewrite real files or real directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Internally map clean URLs to root .html files
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([A-Za-z0-9_-]+)/?$ $1.html [L]
</IfModule>

# -------------------------------------------------------
# CACHE CONTROL — No browser caching for HTML/CSS/JS
# BUT: Allow Last-Modified & ETag so JS can detect updates
# -------------------------------------------------------
<IfModule mod_headers.c>
  # Remove static ETag (file-inode based) — use Last-Modified instead
  FileETag MTime Size
  <FilesMatch "\.(html|htm|css|js)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    # Keep Last-Modified header intact for change detection
    Header always unset ETag
  </FilesMatch>
  # Hide server directory info (security)
  Header always unset X-Powered-By
  Header always unset Server
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Parse .html files as PHP so updates.html and update.html
# can run the news backend. Kept outside the cPanel block above so
# automatic PHP-version updates do not remove it.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .html
</IfModule>
