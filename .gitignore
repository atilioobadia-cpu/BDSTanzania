# ------------------------------------------------------------------
# Sensitive configuration (never commit real credentials)
# ------------------------------------------------------------------
mail-config.php
mail-config.live.php
.env
.env.*
*.local.php
BDST_email_passwords.pdf

# ------------------------------------------------------------------
# Runtime logs (may contain personal data / SMTP debug output)
# ------------------------------------------------------------------
*.log
includes/*.log
logs/
error_log

# ------------------------------------------------------------------
# Uploaded media & temporary uploads
# ------------------------------------------------------------------
assets/images/uploads/
/uploads/
register/uploads/*
!register/uploads/.htaccess
!register/uploads/.gitkeep

# Membership approval documents (managed outside version control;
# production copies live above the web root on cPanel)
storage/approval-docs/*
!storage/approval-docs/.gitkeep
tmp/
tools/geo/.cache/

# Browser-download duplicates
htaccess (1)

# ------------------------------------------------------------------
# OS / editor noise
# ------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------
*.bak
*.swp
__pycache__/
*.pyc
