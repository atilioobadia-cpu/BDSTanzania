<IfModule mod_rewrite.c>
  RewriteEngine On
  # Only the contact form endpoint is allowed through (POST to sendmail.php).
  # Everything else in includes/ (db.php, PHPMailer source, logs) is blocked.
  RewriteCond %{REQUEST_URI} !sendmail\.php$ [NC]
  RewriteRule ^ - [F,L]
  RewriteCond %{REQUEST_METHOD} !=POST [NC]
  RewriteRule ^ - [F,L]
</IfModule>
